# Copy this file to .env.local for `vercel dev`, or add the same name in
# Vercel → Project → Settings → Environment Variables.
#
# Supabase → Project → Connect → "Transaction pooler" connection string (port 6543),
# with your database password filled in:
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Without DATABASE_URL, `npm run dev` uses a local database in the .localdb folder.
